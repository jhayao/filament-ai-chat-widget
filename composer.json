{
    "name": "ferarandrei1/filament-ai-chat-widget",
    "description": "A beautiful AI chat widget plugin for Filament v3 with OpenAI integration",
    "keywords": [
        "filament",
        "laravel",
        "livewire",
        "openai",
        "ai",
        "chat",
        "chatbot",
        "assistant",
        "filament-plugin"
    ],
    "homepage": "https://github.com/ferarandrei1/filament-ai-chat-widget",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Feraru Andrei",
            "email": "feraruandrei@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "filament/filament": "^5.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "laravel/mcp": "*",
        "livewire/livewire": "^4.0",
        "openai-php/laravel": "^0.10|^0.11|^0.12|^0.13|^0.14|^0.15|^0.16|^0.17|^0.18|^0.19|^0.20|^1.0"
    },
    "require-dev": {
        "filament/upgrade": "^5.0",
        "laraveldaily/filacheck": "^1.2",
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Feraandrei1\\FilamentAiChatWidget\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Feraandrei1\\FilamentAiChatWidget\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Feraandrei1\\FilamentAiChatWidget\\FilamentAiChatServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
